<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/mx_hud_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
            android:id="@+id/mx_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:alpha="0"
            android:background="@drawable/gradient_title_player"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingTop="8dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

        <ImageView
                android:id="@+id/mx_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/mx_back"
                android:padding="8dp"
                android:tint="#FFFFFFFF"
                app:srcCompat="@drawable/ic_player_navmenu" />

        <TextView
                android:id="@+id/mx_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        <ImageView
                android:id="@+id/mx_more"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/tracks"
                android:padding="8dp"
                android:tint="#FFFFFFFF"
                app:srcCompat="@drawable/ic_player_more" />
    </LinearLayout>

    <LinearLayout
            android:id="@+id/mx_side_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginRight="12dp"
            android:alpha="0"
            android:background="@drawable/mx_panel_bg"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="6dp"
            android:visibility="gone">

        <ImageView
                android:id="@+id/mx_ratio"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/aspect_ratio"
                android:padding="10dp"
                android:tint="#FFFFFFFF"
                app:srcCompat="@drawable/ic_player_ratio" />

        <ImageView
                android:id="@+id/mx_rotate"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/mx_rotate"
                android:padding="10dp"
                android:tint="#FFFFFFFF"
                app:srcCompat="@drawable/ic_player_rotate" />

        <TextView
                android:id="@+id/mx_speed"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:text="@string/mx_speed_default"
                android:textColor="#FFFF8C00"
                android:textSize="13sp"
                android:textStyle="bold" />

        <ImageView
                android:id="@+id/mx_tracks"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/tracks"
                android:padding="10dp"
                android:tint="#FFFFFFFF"
                app:srcCompat="@drawable/ic_subtitles" />

        <ImageView
                android:id="@+id/mx_lock"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/lock"
                android:padding="10dp"
                android:tint="#FFFFFFFF"
                app:srcCompat="@drawable/ic_lock_player" />
    </LinearLayout>

    <LinearLayout
            android:id="@+id/mx_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:alpha="0"
            android:background="@drawable/gradient_hud_player"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingTop="8dp"
            android:paddingRight="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <TextView
                    android:id="@+id/mx_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:text="@string/mx_zero_time" />

            <SeekBar
                    android:id="@+id/mx_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:progressTint="#FFFF8C00"
                    android:thumbTint="#FFFF8C00" />

            <TextView
                    android:id="@+id/mx_length"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:text="@string/mx_zero_time" />
        </LinearLayout>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="4dp">

            <ImageView
                    android:id="@+id/mx_rewind"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/mx_rewind"
                    android:padding="8dp"
                    android:tint="#FFFFFFFF"
                    app:srcCompat="@drawable/ic_player_rewind_10" />

            <ImageView
                    android:id="@+id/mx_play"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginLeft="24dp"
                    android:layout_marginRight="24dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/mx_play_pause"
                    android:padding="10dp"
                    android:tint="#FFFFFFFF"
                    app:srcCompat="@drawable/ic_pause_player" />

            <ImageView
                    android:id="@+id/mx_forward"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/mx_forward"
                    android:padding="8dp"
                    android:tint="#FFFFFFFF"
                    app:srcCompat="@drawable/ic_player_forward_10" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
